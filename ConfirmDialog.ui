  <property name="styleSheet">
   <string notr="true">/* 对话框整体背景 */
QDialog {
    background-color: #F2F0EB;
}

/* 顶部标题卡片 */
QWidget#titleCard {
    background-color: #FFFFFF;
    border: 1px solid #E0DDD6;
    border-radius: 12px;
}
QLabel#appNameLabel {
    font-size: 18px;
    font-weight: bold;
    color: #2B2B2B;
}
QLabel#appHintLabel {
    font-size: 12px;
    color: #8A8A8A;
}

/* 中部内容卡片 */
QWidget#contentCard {
    background-color: #FFFFFF;
    border: 1px solid #E0DDD6;
    border-radius: 12px;
}
QLabel#pathTitleLabel {
    font-size: 13px;
    font-weight: bold;
    color: #555555;
}
QPlainTextEdit#pathEdit {
    background-color: #F7F5F0;
    border: 1px solid #D8D4CC;
    border-radius: 8px;
    padding: 8px;
    font-family: Consolas, &quot;Courier New&quot;, monospace;
    font-size: 12px;
    color: #333333;
}
QLabel#descTitleLabel {
    font-size: 13px;
    font-weight: bold;
    color: #555555;
}
QPlainTextEdit#descEdit {
    background-color: #F7F5F0;
    border: 1px solid #D8D4CC;
    border-radius: 8px;
    padding: 8px;
    font-size: 13px;
    color: #333333;
}

/* 底部按钮 */
QPushButton#okBtn {
    background-color: #4A90E2;
    color: #FFFFFF;
    border: none;
    border-radius: 8px;
    padding: 8px 22px;
    font-size: 13px;
}
QPushButton#okBtn:hover {
    background-color: #357ABD;
}
QPushButton#okBtn:pressed {
    background-color: #2C6BA8;
}

QPushButton#cancelBtn {
    background-color: #FFFFFF;
    color: #2B2B2B;
    border: 1px solid #D8D4CC;
    border-radius: 8px;
    padding: 8px 22px;
    font-size: 13px;
}
QPushButton#cancelBtn:hover {
    background-color: #F7F5F0;
    border: 1px solid #4A90E2;
    color: #2C6BA8;
}
QPushButton#cancelBtn:pressed {
    background-color: #E8F0FB;
    border: 1px solid #357ABD;
}

/* 滚动条美化 */
QScrollBar:vertical {
    background: transparent;
    width: 10px;
    margin: 0;
}
QScrollBar::handle:vertical {
    background: #C8C4BC;
    border-radius: 5px;
    min-height: 30px;
}
QScrollBar::handle:vertical:hover {
    background: #A8A49C;
}
QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical {
    height: 0;
}
QScrollBar::add-page:vertical,
QScrollBar::sub-page:vertical {
    background: transparent;
}</string>
