  <property name="styleSheet">
   <string notr="true">/* 整体背景：浅暖灰 */
QMainWindow {
    background-color: #F2F0EB;
}

/* 中央容器 */
QWidget#centralWidget {
    background-color: #F2F0EB;
}

/* 更多按钮菜单 */
QMenu {
    background-color: #FFFFFF;
    border: 1px solid #D8D4CC;
    border-radius: 8px;
    padding: 6px;
}
QMenu::item {
    padding: 6px 22px;
    border-radius: 6px;
    font-size: 13px;
    color: #2B2B2B;
}
QMenu::item:selected {
    background-color: #E8F0FB;
    color: #2C6BA8;
}
QMenu::separator {
    height: 1px;
    background: #E0DDD6;
    margin: 4px 8px;
}

/* 滚动条美化 */
QScrollBar:vertical {
    background: transparent;
    width: 10px;
    margin: 0;
}
QScrollBar::handle:vertical {
    background: #C8C4BC;
    border-radius: 5px;
    min-height: 30px;
}
QScrollBar::handle:vertical:hover {
    background: #A8A49C;
}
QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical {
    height: 0;
}
QScrollBar::add-page:vertical,
QScrollBar::sub-page:vertical {
    background: transparent;
}</string>
  </property>
