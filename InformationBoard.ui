  <property name="styleSheet">
   <string notr="true">
QWidget#InformationBoard {
    background-color: #FDFBF7;
    border: 1px solid #D0D0D0;
    border-radius: 10px;
}


QWidget#InformationBoard QLabel {
    background: transparent;
    border: none;
    color: #333333;
}


QLabel#nameLabel {
    font-size: 14px;
    font-weight: bold;
    color: #222222;
}


QLabel#versionLabel {
    color: #666666;
}


QLabel#pathLabel {
    color: #888888;
}


QLabel#registeredLabel {
    color: #2E8B57;
    font-weight: bold;
}

/* 未注册：红色加粗（ registered=false 切换） */
QLabel#registeredLabel[registered="false"] {
    color: #C0392B;
}

/* 智能清理按钮 */
QPushButton#cleanBtn {
    background-color: #4A90E2;
    color: white;
    border: none;
    border-radius: 6px;
    padding: 6px 14px;
    font-size: 13px;
}
QPushButton#cleanBtn:hover {
    background-color: #357ABD;
}
QPushButton#cleanBtn:pressed {
    background-color: #2C6BA8;
}
QPushButton#cleanBtn:disabled {
    background-color: #BFBFBF;
    color: #F0F0F0;
}</string>
